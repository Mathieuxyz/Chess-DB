<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess_DB.ViewModels"
        xmlns:model="using:ChessDB.Model"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Chess_DB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Chess contest Manager"
        Width="1500"
        Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*" Background="#2C3E50">
        <Border Grid.ColumnSpan="2"
                Background="#2C3E50"
                Padding="20">
            <TextBlock Text="Chess contest Manager"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="#34495E">
            <StackPanel Spacing="10"
                        Margin="12">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="14,0"/>
                    </Style>
                </StackPanel.Styles>

                <Button Content="Competitions"
                        Command="{Binding ShowCompetitionsCommand}"/>
                <Button Content="Players"
                        Command="{Binding ShowPlayersCommand}"/>
                <Button Content="Registrations"
                        Command="{Binding ShowRegistrationsCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#ECF0F1"
                CornerRadius="12"
                Margin="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Players -->
                <ScrollViewer IsVisible="{Binding IsPlayersPage}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="2*,1.2*"
                          RowDefinitions="Auto,*"
                          HorizontalAlignment="Stretch">
                    <ComboBox Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding Players}"
                              SelectedItem="{Binding SelectedPlayer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:Player">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                            <Binding Path="LastName"/>
                                            <Binding Path="FirstName"/>
                                            <Binding Path="ShortId"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Player details -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="12"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <ContentControl Content="{Binding SelectedPlayer}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="model:Player">
                                    <StackPanel Spacing="6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding FirstName}" FontWeight="Bold" FontSize="16"/>
                                            <TextBlock Text="{Binding LastName}" FontSize="14" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding CurrentElo, StringFormat='ELO: {0:F0}'}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="ELO history" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                        <ItemsControl ItemsSource="{Binding EloRatings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Rating, StringFormat='- {0}'}"
                                                               FontSize="12"
                                                               Foreground="#7F8C8D"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>

                    <!-- Add player form -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="12" Width="360">
                            <TextBlock Text="Add player" FontWeight="Bold" FontSize="18"/>
                            <TextBox Watermark="First name" Text="{Binding NewFirstName}" Height="40"/>
                            <TextBox Watermark="Last name" Text="{Binding NewLastName}" Height="40"/>
                            <TextBox Watermark="Email" Text="{Binding NewEmail}" Height="40"/>
                            <TextBox Watermark="Phone" Text="{Binding NewPhoneNumber}" Height="40"/>
                            <TextBox Watermark="Current ELO" Text="{Binding NewElo}" Height="40"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add"
                                        MinWidth="100"
                                        Height="42"
                                        Command="{Binding AddPlayerCommand}"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                                <Button Content="Save form"
                                        MinWidth="120"
                                        Height="42"
                                        Command="{Binding SavePlayerFormCommand}"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                                <Button Content="Submit"
                                        MinWidth="120"
                                        Height="42"
                                        Command="{Binding AddPlayerCommand}"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Competitions -->
                <ItemsControl ItemsSource="{Binding Competitions}"
                              IsVisible="{Binding IsCompetitionsPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Height="350">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Grid.Row="1" Text="{Binding StartDate, StringFormat='Start: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Row="2" Text="{Binding EndDate, StringFormat='End: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>

                                        <StackPanel Grid.Row="3" Spacing="4">
                                            <TextBlock Text="Games" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <Border BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="4" Background="#F7F9FA">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Games}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding $parent[Window].DataContext.ShowGameDetailCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0">
                                                                    <Border Padding="6"
                                                                            Margin="6"
                                                                            Background="White"
                                                                            BorderBrush="#D0D7DE"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{Binding PlayedOn, StringFormat='Date: {0:d}'}" FontSize="12"/>
                                                                            <TextBlock Text="{Binding WhitePlayerId, StringFormat='White: {0}'}" FontSize="12"/>
                                                                            <TextBlock Text="{Binding BlackPlayerId, StringFormat='Black: {0}'}" FontSize="12"/>
                                                                            <TextBlock Text="{Binding Result, StringFormat='Result: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Registrations -->
                <Grid IsVisible="{Binding IsRegistrationsPage}"
                      RowDefinitions="Auto,Auto,*,Auto"
                      HorizontalAlignment="Stretch">
                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Background="White"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Select competition" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Competitions}"
                                      SelectedItem="{Binding SelectedCompetitionForRegistration}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                  </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Background="White"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Create competition" FontWeight="SemiBold"/>
                            <TextBox Watermark="Name"
                                     Text="{Binding NewCompetitionName}"
                                     Height="32"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Width="180" Spacing="4">
                                    <TextBlock Text="Start date" FontWeight="SemiBold" FontSize="12"/>
                                    <DatePicker SelectedDate="{Binding NewCompetitionStartDate}"/>
                                </StackPanel>
                                <StackPanel Width="180" Spacing="4">
                                    <TextBlock Text="End date" FontWeight="SemiBold" FontSize="12"/>
                                    <DatePicker SelectedDate="{Binding NewCompetitionEndDate}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Add competition"
                                    Height="32"
                                    MinWidth="140"
                                    Command="{Binding AddCompetitionCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RegistrablePlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Content="Submit registrations"
                                Command="{Binding AddRegistrationCommand}"
                                Height="36"
                                MinWidth="160"/>
                    </StackPanel>
                </Grid>

                <!-- Game detail overlay -->
                <Grid IsVisible="{Binding IsGameDetailPage}"
                      Background="#CCFFFFFF">
                    <Border Padding="20"
                            Background="Transparent">
                        <Border Background="White"
                                CornerRadius="10"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                Padding="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="800">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Game details" FontSize="22" FontWeight="Bold"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="White player" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Players}"
                                              SelectedItem="{Binding SelectedWhitePlayer}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="model:Player">
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="ShortId"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Black player" FontWeight="SemiBold"/>
                                    <ComboBox ItemsSource="{Binding Players}"
                                              SelectedItem="{Binding SelectedBlackPlayer}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="model:Player">
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}, {1}, {2}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                            <Binding Path="ShortId"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <StackPanel Width="200" Spacing="4">
                                        <TextBlock Text="Piece" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding MovePieces}"
                                                  SelectedItem="{Binding SelectedMovePiece}"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Spacing="4">
                                        <TextBlock Text="Destination" FontWeight="SemiBold"/>
                                        <ComboBox ItemsSource="{Binding MoveSquares}"
                                                  SelectedItem="{Binding SelectedMoveSquare}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Confirm"
                                            Command="{Binding ConfirmGamePlayersCommand}"
                                            Height="36"
                                            MinWidth="120"/>
                                    <Button Content="Back"
                                            Command="{Binding BackToCompetitionsCommand}"
                                            Height="36"
                                            MinWidth="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>

</Window>
