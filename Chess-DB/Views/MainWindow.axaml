<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess_DB.ViewModels"
        xmlns:model="using:ChessDB.Model"
        xmlns:conv="using:Chess_DB.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Chess_DB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding ProgramName}"
        Width="1500"
        Height="700">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:PlayerNameLabelConverter x:Key="PlayerNameLabelConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*" Background="#2C3E50">
        <Border Grid.ColumnSpan="2"
                Background="#2C3E50"
                Padding="20">
            <TextBlock Text="{Binding ProgramName}"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="#34495E">
            <StackPanel Spacing="10"
                        Margin="12">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="14,0"/>
                    </Style>
                </StackPanel.Styles>

                <Button Content="Home"
                        Command="{Binding ShowHomeCommand}"/>
                <Button Content="Competitions"
                        Command="{Binding ShowCompetitionsCommand}"/>
                <Button Content="Players"
                        Command="{Binding ShowPlayersCommand}"/>
                <Button Content="Registrations"
                        Command="{Binding ShowRegistrationsCommand}"/>
                <Button Content="Settings"
                        Command="{Binding ShowResetCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#ECF0F1"
                CornerRadius="12"
                Margin="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- Home -->
                <Grid IsVisible="{Binding IsHomePage}"
                      ColumnDefinitions="*,*"
                      RowDefinitions="*"
                      ColumnSpacing="16"
                      Margin="0,0,0,0">
                    <Border Grid.Column="0"
                            Background="White"
                            Padding="16"
                            CornerRadius="10"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Upcoming competitions"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"/>
                            <ItemsControl ItemsSource="{Binding UpcomingCompetitions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Competition">
                                        <Border Padding="10"
                                                Margin="0,4"
                                                Background="#F7F9FA"
                                                CornerRadius="6"
                                                BorderBrush="#E0E6ED"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#1F2937"/>
                                                <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:d}'}" FontSize="12" Foreground="#374151"/>
                                                <TextBlock Text="{Binding EndDate, StringFormat='End: {0:d}'}" FontSize="12" Foreground="#374151"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Registrations.Count, StringFormat='Players: {0}'}" FontSize="12" Foreground="#1F2937"/>
                                                    <TextBlock Text="{Binding Games.Count, StringFormat='Matches: {0}'}" FontSize="12" Foreground="#1F2937"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Background="White"
                            Padding="16"
                            CornerRadius="10"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            Margin="8,0,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding TopRankingPlayersTitle}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"/>
                            <ItemsControl ItemsSource="{Binding TopPlayers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="model:Player" x:CompileBindings="False">
                                        <Border Padding="10"
                                                Margin="0,4"
                                                Background="#F7F9FA"
                                                CornerRadius="6"
                                                BorderBrush="#E0E6ED"
                                                BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding LastName}" FontWeight="SemiBold" FontSize="15" Foreground="#1F2937"/>
                                                <TextBlock Text="{Binding FirstName}" FontSize="13" Foreground="#1F2937"/>
                                                <TextBlock FontSize="12" Foreground="#1F2937">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}: {1:F0}">
                                                            <Binding Path="DataContext.RankingName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            <Binding Path="CurrentElo"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Players -->
                <ScrollViewer IsVisible="{Binding IsPlayersPage}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="2*,1.2*"
                          RowDefinitions="Auto,*"
                          HorizontalAlignment="Stretch">
                    <ComboBox Grid.Row="0"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,10"
                              ItemsSource="{Binding Players}"
                              SelectedItem="{Binding SelectedPlayer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="model:Player">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}, {1}">
                                            <Binding Path="LastName"/>
                                            <Binding Path="FirstName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Player details -->
                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            Padding="12"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <ContentControl Content="{Binding SelectedPlayer}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="model:Player" x:CompileBindings="False">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding FirstName}" FontWeight="Bold" FontSize="22" Foreground="#1F2937"/>
                                            <TextBlock Text="{Binding LastName}" FontSize="18" FontWeight="SemiBold" Foreground="#1F2937"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Email}" FontSize="14" Foreground="#1F2937"/>
                                        <TextBlock Text="{Binding PhoneNumber}" FontSize="14" Foreground="#1F2937"/>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#1F2937">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}: {1:F0}">
                                                    <Binding Path="DataContext.RankingName" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="CurrentElo"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DataContext.RankingHistoryTitle, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" FontSize="14" Margin="0,8,0,2" Foreground="#1F2937"/>
                                        <ItemsControl ItemsSource="{Binding EloRatings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Rating, StringFormat='- {0}'}"
                                                               FontSize="13"
                                                               Foreground="#1F2937"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Border>

                    <!-- Add player form -->
                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="12" Width="360">
                            <TextBlock Text="Player registration form"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       Foreground="#1F2937"
                                       Margin="0,0,0,4"/>
                            <TextBox Watermark="First name" Text="{Binding NewFirstName}" Height="40"/>
                            <TextBox Watermark="Last name" Text="{Binding NewLastName}" Height="40"/>
                            <TextBox Watermark="Email" Text="{Binding NewEmail}" Height="40"/>
                            <TextBox Watermark="Phone" Text="{Binding NewPhoneNumber}" Height="40"/>
                            <TextBox Watermark="{Binding CurrentRankingWatermark}" Text="{Binding NewElo}" Height="40"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Save form"
                                        MinWidth="120"
                                        Height="42"
                                        Command="{Binding SavePlayerFormCommand}"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                                <Button Content="Submit"
                                        MinWidth="120"
                                        Height="42"
                                        Command="{Binding AddPlayerCommand}"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Competitions -->
                <ItemsControl ItemsSource="{Binding Competitions}"
                              IsVisible="{Binding IsCompetitionsPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Height="350">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="18" Foreground="#1F2937"/>
                                        <TextBlock Grid.Row="1" Text="{Binding StartDate, StringFormat='Start: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Row="2" Text="{Binding EndDate, StringFormat='End: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>

                                        <StackPanel Grid.Row="3" Spacing="4">
                                            <TextBlock Text="Games" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Games.Count, StringFormat='Matches: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,4"/>
                                            <Border BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="4" Background="#F7F9FA">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Games}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:CompileBindings="False">
                                                                <Button Command="{Binding $parent[Window].DataContext.ShowGameDetailCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0">
                                                                    <Border Padding="6"
                                                                            Margin="6"
                                                                            Background="White"
                                                                            BorderBrush="#D0D7DE"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4">
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock Text="{Binding MatchNumber, StringFormat='Match {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#1F2937"/>
                                                                            <TextBlock Text="{Binding PlayedOn, StringFormat='Date: {0:d}'}" FontSize="12" Foreground="#1F2937"/>
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock>
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{StaticResource PlayerNameLabelConverter}" ConverterParameter="White">
                                                                                            <Binding Path="WhitePlayerId"/>
                                                                                            <Binding Path="DataContext.Players" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                                <TextBlock>
                                                                                    <TextBlock.Text>
                                                                                        <MultiBinding Converter="{StaticResource PlayerNameLabelConverter}" ConverterParameter="Black">
                                                                                            <Binding Path="BlackPlayerId"/>
                                                                                            <Binding Path="DataContext.Players" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                        </MultiBinding>
                                                                                    </TextBlock.Text>
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding Result, StringFormat='Result: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Registrations -->
                <Grid IsVisible="{Binding IsRegistrationsPage}"
                      RowDefinitions="Auto,Auto"
                      HorizontalAlignment="Stretch">
                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Background="White"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Register players to a competition" FontWeight="Bold" FontSize="18" Foreground="#1F2937"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Select competition" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                <ComboBox ItemsSource="{Binding Competitions}"
                                          SelectedItem="{Binding SelectedCompetitionForRegistration}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="#1F2937" FontSize="14"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="Choose players" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937" Margin="0,4,0,0"/>
                            <Border BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="6" Background="#F7F9FA">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="220">
                                    <ItemsControl ItemsSource="{Binding RegistrablePlayers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding Display}"
                                                          Margin="8,4"
                                                          FontSize="14"
                                                          Foreground="#1F2937"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Submit registrations"
                                        Command="{Binding AddRegistrationCommand}"
                                        Height="36"
                                        MinWidth="180"
                                        Background="#2C3E50"
                                        Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="White"
                            Padding="12"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Create competition" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                            <TextBox Watermark="Name"
                                     Text="{Binding NewCompetitionName}"
                                     Height="32"
                                     FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Width="180" Spacing="4">
                                    <TextBlock Text="Start date" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937"/>
                                    <DatePicker SelectedDate="{Binding NewCompetitionStartDate}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Width="180" Spacing="4">
                                    <TextBlock Text="End date" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937"/>
                                    <DatePicker SelectedDate="{Binding NewCompetitionEndDate}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Width="160" Spacing="4">
                                    <TextBlock Text="Number of matches" FontWeight="SemiBold" FontSize="12" Foreground="#1F2937"/>
                                    <NumericUpDown Minimum="1"
                                                   Maximum="500"
                                                   Value="{Binding NewCompetitionMatchCount}"
                                                   Height="32"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Add competition"
                                    Height="32"
                                    MinWidth="140"
                                    Command="{Binding AddCompetitionCommand}"
                                    Background="#2C3E50"
                                    Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Reset Everything -->
                <Grid IsVisible="{Binding IsResetPage}"
                      RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="White"
                            Padding="16"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Reset Everything"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#1F2937"/>
                                <TextBlock Text="Clear everything from the database. Includes rules, moves and ranking method. This action is irreversible."
                                           FontSize="14"
                                           Foreground="#4B5563"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Reset everything"
                                    Command="{Binding ToggleResetConfirmationCommand}"
                                    Background="#C0392B"
                                    Foreground="White"
                                    Height="32"
                                    MinWidth="140"/>
                            <Button Grid.Column="2"
                                    Content="Are you sure ?"
                                    Command="{Binding ResetEverythingCommand}"
                                    Background="#922B21"
                                    Foreground="White"
                                    Height="32"
                                    MinWidth="140"
                                    IsVisible="{Binding ShowResetConfirmation}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            Padding="16"
                            CornerRadius="8"
                            BorderBrush="#D0D7DE"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Settings change"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="It is advised to delete all previous data to avoid problems with stacking"
                                       FontWeight="SemiBold"
                                       Foreground="#922B21"/>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Program name" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                                <TextBox Text="{Binding EditableProgramName}" Height="32" />

                                <TextBlock Text="Ranking name" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                                <TextBox Text="{Binding EditableRankingName}" Height="32" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Move pieces" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox Width="180" Text="{Binding NewMovePiece}" Watermark="Add piece"/>
                                        <Button Content="Add" Command="{Binding AddMovePieceCommand}" MinWidth="60"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding EditableMovePieces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <TextBox Text="{Binding .}" Width="180"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveMovePieceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}"
                                                            MinWidth="70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Move squares" FontWeight="SemiBold" FontSize="14" Foreground="#1F2937"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBox Width="180" Text="{Binding NewMoveSquare}" Watermark="Add square (e.g. E4)"/>
                                        <Button Content="Add" Command="{Binding AddMoveSquareCommand}" MinWidth="60"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding EditableMoveSquares}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:CompileBindings="False">
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                    <TextBox Text="{Binding .}" Width="120"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.RemoveMoveSquareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding .}"
                                                            MinWidth="70"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Submit settings"
                                        Command="{Binding ToggleSettingsConfirmationCommand}"
                                        Height="32"
                                        MinWidth="140"
                                        Background="#C0392B"
                                        Foreground="White"/>
                                <Button Content="Are you sure ?"
                                        Command="{Binding SaveSettingsCommand}"
                                        Height="32"
                                        MinWidth="140"
                                        Background="#922B21"
                                        Foreground="White"
                                        IsVisible="{Binding ShowSettingsConfirmation}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Game detail overlay -->
                <Grid IsVisible="{Binding IsGameDetailPage}"
                      Background="#CCFFFFFF">
                    <Border Padding="20"
                            Background="Transparent">
                        <Border Background="White"
                                CornerRadius="10"
                                BorderBrush="#D0D7DE"
                                BorderThickness="1"
                                Padding="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="800">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Game details" FontSize="22" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <StackPanel Width="240" Spacing="8">
                                        <TextBlock Text="White player" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                        <ComboBox ItemsSource="{Binding Players}"
                                                  SelectedItem="{Binding SelectedWhitePlayer}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="model:Player">
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}, {1}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Width="240" Spacing="8">
                                        <TextBlock Text="Black player" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                        <ComboBox ItemsSource="{Binding Players}"
                                                  SelectedItem="{Binding SelectedBlackPlayer}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="model:Player">
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}, {1}">
                                                            <Binding Path="LastName"/>
                                                            <Binding Path="FirstName"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Button Content="Save players"
                                                Command="{Binding ConfirmGamePlayersCommand}"
                                                Height="36"
                                                MinWidth="140"
                                                Background="#2C3E50"
                                                Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Saved moves" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                        <Border BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="4" Background="#F7F9FA" Padding="6">
                                            <ScrollViewer MaxHeight="150">
                                                <ItemsControl ItemsSource="{Binding SelectedGame.Moves}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="model:Move">
                                                            <TextBlock Text="{Binding Notation}" FontSize="13" Foreground="#1F2937"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding MoveForms}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MoveForm" x:CompileBindings="False">
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                                                    <StackPanel Width="200" Spacing="4">
                                                        <TextBlock Text="Piece" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                                        <ComboBox ItemsSource="{Binding Path=DataContext.MovePieces, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Piece}"/>
                                                    </StackPanel>
                                                    <StackPanel Width="200" Spacing="4">
                                                        <TextBlock Text="Destination" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                                        <ComboBox ItemsSource="{Binding Path=DataContext.MoveSquares, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Square}"/>
                                                    </StackPanel>
                                                    <StackPanel Width="220" Spacing="4">
                                                        <TextBlock Text="Move played by" FontWeight="SemiBold" FontSize="16" Foreground="#1F2937"/>
                                                        <ComboBox ItemsSource="{Binding Path=DataContext.MovePlayers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  SelectedItem="{Binding Player}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="model:Player">
                                                                    <TextBlock>
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                                                <Binding Path="LastName"/>
                                                                                <Binding Path="FirstName"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Add move row"
                                                Command="{Binding AddMoveRowCommand}"
                                                Height="32"
                                                MinWidth="140"/>
                                        <Button Content="Save moves"
                                                Command="{Binding SaveMovesCommand}"
                                                Height="32"
                                                MinWidth="140"
                                                Background="#2C3E50"
                                                Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Back"
                                            Command="{Binding BackToCompetitionsCommand}"
                                            Height="36"
                                            MinWidth="100"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>

</Window>
