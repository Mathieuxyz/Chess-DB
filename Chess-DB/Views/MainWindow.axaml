<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess_DB.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
        x:Class="Chess_DB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Chess contest Manager">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*" Background="#2C3E50">
        <Border Grid.ColumnSpan="2"
                Background="#2C3E50"
                Padding="20">
            <TextBlock Text="Chess contest Manager"
                       Foreground="White"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1"
                Background="#34495E">
            <StackPanel Spacing="10"
                        Margin="12">
                <StackPanel.Styles>
                    <Style Selector="Button">
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Background" Value="#2C3E50"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="14,0"/>
                    </Style>
                </StackPanel.Styles>

                <Button Content="Competitions"
                        Command="{Binding ShowCompetitionsCommand}"/>
                <Button Content="Players"
                        Command="{Binding ShowPlayersCommand}"/>
                <Button Content="Registrations"
                        Command="{Binding ShowRegistrationsCommand}"/>
                <Button Content="Games"
                        Command="{Binding ShowGamesCommand}"/>
                <Button Content="ELO rankings"
                        Command="{Binding ShowEloRankingsCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Background="#ECF0F1"
                CornerRadius="12"
                Margin="20">
            <Grid>
                <!-- Default text for non-card pages -->
                <TextBlock Text="{Binding ContentText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           Foreground="#7F8C8D"/>

                <!-- Players -->
                <ItemsControl ItemsSource="{Binding Players}"
                              IsVisible="{Binding IsPlayersPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding FirstName}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding LastName}" FontSize="14" />
                                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding CurrentElo, StringFormat='ELO: {0:F0}'}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Competitions -->
                <ItemsControl ItemsSource="{Binding Competitions}"
                              IsVisible="{Binding IsCompetitionsPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='End: {0:d}'}" FontSize="12" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Registrations -->
                <ItemsControl ItemsSource="{Binding Registrations}"
                              IsVisible="{Binding IsRegistrationsPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding PlayerId, StringFormat='Player: {0}'}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CompetitionId, StringFormat='Competition: {0}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Games -->
                <ItemsControl ItemsSource="{Binding Games}"
                              IsVisible="{Binding IsGamesPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding PlayedOn, StringFormat='Date: {0:d}'}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding CompetitionId, StringFormat='Competition: {0}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding WhitePlayerId, StringFormat='White: {0}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding BlackPlayerId, StringFormat='Black: {0}'}" FontSize="12"/>
                                    <TextBlock Text="{Binding Result, StringFormat='Result: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ELO Rankings -->
                <ItemsControl ItemsSource="{Binding EloRatings}"
                              IsVisible="{Binding IsEloPage}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10"
                                    Padding="12"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Date, StringFormat='Date: {0:d}'}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Rating, StringFormat='ELO: {0}'}" FontSize="12" Foreground="#7F8C8D"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>

</Window>
